{
  "rules": {
    ".read": false,
    ".write": false,

    "device": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'device'",
      ".validate": "newData.hasChild('lastSeen')",
      "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
      "firmware": { ".validate": "newData.isString() && newData.val().length <= 20" },
      "ip": { ".validate": "newData.isString() && newData.val().length <= 45" },
      "$other": { ".validate": false }
    },

    "channels": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'device')",

      "$ch": {
        ".validate": "$ch.matches(/^ch[0-9]+$/)",

        "tenantName": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').val() === $ch",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },

        "remainingBalance": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').val() === $ch",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'device'",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "originalAllocation": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').val() === $ch",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'device'",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },

        "relayStatus": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').val() === $ch",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'device'",
          ".validate": "newData.val() === 'ON' || newData.val() === 'OFF'"
        },

        "live": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').val() === $ch",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'device'",
          ".validate": "newData.hasChildren(['voltage', 'current', 'power', 'pf', 'energy', 'frequency', 'ts'])",
          "voltage": { ".validate": "newData.isNumber()" },
          "current": { ".validate": "newData.isNumber()" },
          "power": { ".validate": "newData.isNumber()" },
          "pf": { ".validate": "newData.isNumber()" },
          "energy": { ".validate": "newData.isNumber()" },
          "frequency": { ".validate": "newData.isNumber()" },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        },

        "history": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').val() === $ch",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'device'",
          "$day": {
            ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "$hhmm": {
              ".validate": "$hhmm.matches(/^[0-9]{4}$/) && newData.hasChildren(['power', 'balance'])",
              "power": { ".validate": "newData.isNumber()" },
              "balance": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            }
          }
        },

        "pendingTopUps": {
          "$id": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'device' && data.exists() && !newData.exists() && newData.parent().parent().parent().parent().child('topUpLog').child($id).child('appliedAt').exists()))",
            ".validate": "newData.hasChildren(['kwh', 'requestedAt']) && newData.parent().parent().parent().parent().child('topUpLog').child($id).child('channel').val() === $ch && newData.parent().parent().parent().parent().child('topUpLog').child($id).child('kwh').val() === newData.child('kwh').val()",
            "kwh": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500" },
            "requestedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "control": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'device')",

      "disconnect": {
        "$ch": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').val() === $ch",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
          ".validate": "$ch.matches(/^ch[0-9]+$/) && newData.isBoolean()"
        }
      },

      "resetUnits": {
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' && newData.exists()) || (root.child('users').child(auth.uid).child('role').val() === 'device' && data.exists() && !newData.exists()))",
        ".validate": "newData.hasChildren(['requestedAt', 'by'])",
        "requestedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "by": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "$other": { ".validate": false }
      },

      "$other": { ".validate": false }
    },

    "topUpLog": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').exists() && query.orderByChild === 'channel' && query.equalTo === root.child('users').child(auth.uid).child('channel').val()))",
      ".indexOn": ["channel", "requestedAt"],

      "$id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && data.child('channel').val() === root.child('users').child(auth.uid).child('channel').val()",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['channel', 'kwh', 'by', 'requestedAt']) && (data.exists() || !newData.child('appliedAt').exists())",
        "channel": { ".validate": "newData.isString() && newData.val().matches(/^ch[0-9]+$/)" },
        "kwh": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500" },
        "by": { ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())" },
        "requestedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "appliedAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'device' && !data.exists() && newData.exists() && root.child('channels').child(newData.parent().child('channel').val()).child('pendingTopUps').child($id).exists() && !newData.parent().parent().parent().child('channels').child(newData.parent().child('channel').val()).child('pendingTopUps').child($id).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": { ".validate": false }
      }
    },

    "topUpRequests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'tenant' && root.child('users').child(auth.uid).child('channel').exists() && query.orderByChild === 'channel' && query.equalTo === root.child('users').child(auth.uid).child('channel').val()))",
      ".indexOn": ["channel", "status"],

      "$id": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'tenant' && data.child('channel').val() === root.child('users').child(auth.uid).child('channel').val()",
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' && data.exists() && newData.exists()) || (root.child('users').child(auth.uid).child('role').val() === 'tenant' && !data.exists() && newData.exists()))",
        ".validate": "newData.hasChildren(['channel', 'kwh', 'requestedAt', 'status']) && ((!data.exists() && newData.child('channel').val() === root.child('users').child(auth.uid).child('channel').val() && newData.child('status').val() === 'waiting' && !newData.child('decidedAt').exists()) || (data.exists() && data.child('status').val() === 'waiting' && newData.child('status').val() !== 'waiting' && newData.child('decidedAt').exists() && newData.child('channel').val() === data.child('channel').val() && newData.child('kwh').val() === data.child('kwh').val() && newData.child('requestedAt').val() === data.child('requestedAt').val()))",
        "channel": { ".validate": "newData.isString() && newData.val().matches(/^ch[0-9]+$/)" },
        "kwh": { ".validate": "newData.isNumber() && newData.val() >= 0.001 && newData.val() <= 500" },
        "requestedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "status": { ".validate": "newData.val() === 'waiting' || newData.val() === 'approved' || newData.val() === 'declined'" },
        "decidedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChild('role')",
        "role": { ".validate": "newData.val() === 'admin' || newData.val() === 'tenant' || newData.val() === 'device'" },
        "channel": { ".validate": "newData.isString() && newData.val().matches(/^ch[0-9]+$/)" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "mustChangePassword": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === false",
          ".validate": "newData.isBoolean()"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
